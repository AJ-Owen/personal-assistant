ANTHROPIC_API_KEY=sk-ant-...
TODOIST_API_KEY=your-todoist-api-token

# Path inside the container where the vault is mounted
VAULT_PATH=/vault
INBOX_FILENAME=inbox.md

# Optional: static bearer token for webhook auth (empty = no auth)
WEBHOOK_TOKEN=

# Docker Compose: host path to your Obsidian vault
# VAULT_HOST_PATH=/path/to/your/obsidian/vault

# Timezone for the scheduled inbox processing (IANA tz name)
TZ=Europe/London

# Hour (in TZ timezone) to run daily inbox processing (default: 6 = 6am)
# PROCESS_HOUR=6

# Vault-relative folder for processed inbox archives (default: archive/inbox)
# INBOX_ARCHIVE_PATH=archive/inbox

# Vault-relative folder for the verbatim raw-capture log (default: archive/capture)
# CAPTURE_LOG_PATH=archive/capture

# ---- ntfy push notifications ----
# The assistant's only outbound channel to you: answers to questions, failures,
# and anything it couldn't file. Leave NTFY_TOPIC empty to disable entirely —
# the notify_user tool is then not offered to the model at all.
#
# Set up a dedicated write-only publisher on your ntfy server (do NOT reuse a
# credential that other services publish under):
#   ntfy user add --role=user assistant
#   ntfy access assistant <topic> write-only
#   ntfy token add --label "assistant-agent" assistant
# Subscribe on your phone with an account that has READ access to the topic —
# a write-only publisher cannot read it back, and anonymous access is denied
# when the server sets auth-default-access: deny-all.
NTFY_URL=http://ntfy:80
NTFY_TOPIC=
NTFY_TOKEN=
